[Unit]
Description=pve-glance — live at-a-glance dashboard for Proxmox VE
Documentation=https://github.com/antonflor/pve-glance
After=pve-cluster.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 /opt/pve-glance/pve-glance.py
Restart=on-failure
RestartSec=5
# Runs as root so `pvesh` can read cluster resources without an API token.
# Optional configuration — uncomment and edit as needed:
#Environment=PVE_GLANCE_PORT=8008
#Environment=PVE_GLANCE_BIND=0.0.0.0
#Environment=PVE_GLANCE_AUTH=admin:changeme

[Install]
WantedBy=multi-user.target
